# Mobile push (optional, see docs/FIREBASE-SETUP.md)
# FCM_CREDENTIALS_PATH=/home/youruser/.wab-secrets/firebase.json
# FCM_PROJECT_ID=your-firebase-project-id
APP_NAME="WA Business Fineoutput Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_business
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Kolkata
# Seeder: admin login. Leave ADMIN_PASSWORD empty to generate one into ../secrets/admin-credentials.txt (chmod 600)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Meta Graph API (credentials themselves are entered in the portal Settings page, stored encrypted)
META_GRAPH_VERSION=v26.0
# For local demos only: META_GRAPH_BASE=http://127.0.0.1:8099 (tools/mock-meta.php). Default https://graph.facebook.com
