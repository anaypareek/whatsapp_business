# WhatsApp Business portal: same-domain routing (SPA + Laravel API)
Options -Indexes -MultiViews
DirectoryIndex disabled
ErrorDocument 404 /web/site/404.html
ErrorDocument 403 /web/site/404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Force HTTPS (leave ACME challenge on http for AutoSSL)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pass Authorization header to PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^\.well-known/ - [END]

# Block dotfiles/dirs (.env, .git, …), repo files and source folders
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(README\.md|docs|tools|secrets)(/|$) - [F,END]

# Uploaded media
RewriteCond %{DOCUMENT_ROOT}/api/public/storage/$1 -f
RewriteRule ^storage/(.+)$ api/public/storage/$1 [END]

# API + health check -> Laravel front controller
RewriteRule ^(api|up)(/.*)?$ api/public/index.php [END]

# Public 404 page + landing page (no admin links)
RewriteRule ^web/site/(index|404)\.html$ - [END]

# Admin panel (SPA). Must match VITE_ADMIN_BASE used at build time (default /wab-control-7x).
RewriteRule ^wab-control-7x$ /wab-control-7x/ [R=302,L]
RewriteCond %{DOCUMENT_ROOT}/web/dist/$1 -f
RewriteRule ^wab-control-7x/(.+)$ web/dist/$1 [END]
RewriteRule ^wab-control-7x/ web/dist/index.html [END]

# Public landing page at /
RewriteRule ^$ web/site/index.html [END]

# Everything else (including /admin) -> 404
RewriteRule ^ - [R=404,L]
